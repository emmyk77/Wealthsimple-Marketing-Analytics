		formatString: "CAD "#,0.00
		displayFolder: Overview
		lineageTag: 20462f17-0f55-4e79-9145-bf6265d0dcdd

	measure Impressions = CALCULATE(SUM(Fact_Campaigns[raw_impressions]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 1a620df0-185a-4957-8c26-754a6a64bd3c

	measure Clicks = CALCULATE(SUM(Fact_Campaigns[raw_clicks]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: f57557e0-53d7-486d-a58a-afcdf432a1b1

	measure Signups = CALCULATE(SUM(Fact_Campaigns[raw_signups]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 8dbf8250-496f-4c7a-9124-65398af82672

	measure 'KYC Started' = CALCULATE(SUM(Fact_Campaigns[kyc_started]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 199fe9db-9abf-4abd-bdac-0a2921812bed

	measure 'KYC Completed' = CALCULATE(SUM(Fact_Campaigns[kyc_completed]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: c70fae9c-df1f-4238-a62c-fe8f9f936720

	measure 'Funded Accounts' = CALCULATE(SUM(Fact_Campaigns[funded_accounts]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: b2a805c0-302e-438c-a580-0add92371474

	measure 'Paying Customers' = CALCULATE(SUM(Fact_Campaigns[paying_customers]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 23e78cad-0f91-403c-b163-4a52a3dc12b4

	measure CAC = DIVIDE([Total Spend],[Paying Customers])
		formatString: "CAD "#,0.00
		displayFolder: Efficiency
		lineageTag: b4be8341-e7be-43a4-8711-6925cf0dcb14

	measure CPC = DIVIDE([Total Spend],[Clicks])
		formatString: "CAD "#,0.00
		displayFolder: Efficiency
		lineageTag: 52e23550-defa-4525-958c-d2c3bf47880f

	measure CPS = DIVIDE([Total Spend],[Signups])
		formatString: "CAD "#,0.00
		displayFolder: Efficiency
		lineageTag: 8ecfa783-d5c8-4b7e-adec-c34d8bd5382b

	measure CTR = DIVIDE([Clicks],[Impressions])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: 0bf040e6-172c-4fcf-8cae-497158a33cb9

	measure 'Click to Signup' = DIVIDE([Signups],[Clicks])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: 2b7f5926-dfe3-46e8-8718-7167d7296988

	measure 'Signup to Funded' = DIVIDE([Funded Accounts],[Signups])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: 361ea1f2-2fc0-422a-9341-2d5f1d2fd6fc

	measure 'Funded to Paying' = DIVIDE([Paying Customers],[Funded Accounts])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: fb2b9e17-8f26-40bb-98ac-32920e2c64fb

	measure 'Signup to Paying' = DIVIDE([Paying Customers],[Signups])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: d56a9b4d-86e9-40c0-a627-4a1482604a56

	measure 'KYC Completion' = DIVIDE([KYC Completed],[KYC Started])
		formatString: 0.00%
		displayFolder: Efficiency
		lineageTag: 634da67a-a042-4995-acb0-9113f4a31fd4

	measure 'First Month Revenue' = CALCULATE(SUM(Fact_Campaigns[first_month_revenue_cad]), KEEPFILTERS(Fact_Campaigns[revenue_eligible] = TRUE()))
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: cc65446c-7a7a-4c2e-86c5-20461e611cf1

	measure 'Matched Cost' = CALCULATE(SUM(Fact_Campaigns[total_marketing_cost_cad]), KEEPFILTERS(Fact_Campaigns[revenue_eligible] = TRUE()))
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: f4712e98-4677-48ab-85e1-5a921f466a2b

	measure 'Matched Paying Customers' = CALCULATE(SUM(Fact_Campaigns[paying_customers]), KEEPFILTERS(Fact_Campaigns[revenue_eligible] = TRUE()))
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: d8a9cbb3-cecf-4688-b0ee-f1b7c790e2c3

	measure ROAS = DIVIDE(CALCULATE(SUM(Fact_Campaigns[first_month_revenue_cad]),KEEPFILTERS(Fact_Campaigns[roas_eligible] = TRUE())),CALCULATE(SUM(Fact_Campaigns[ad_spend_cad]),KEEPFILTERS(Fact_Campaigns[roas_eligible] = TRUE())))
		formatString: 0.0000"x"
		displayFolder: Revenue
		lineageTag: 21b48d89-57ae-4b5a-a193-6b0077021a16

	measure 'Revenue to Marketing Cost' = DIVIDE([First Month Revenue],[Matched Cost])
		formatString: 0.0000"x"
		displayFolder: Revenue
		lineageTag: 166c993f-ee3e-4505-b95f-e7fd3bc77d17

	measure 'Revenue Cost Gap' = [First Month Revenue] - [Matched Cost]
		formatString: "CAD "#,0.00
		displayFolder: Revenue
		lineageTag: 9ac2e688-cec0-4caf-adab-1c6d7eb0c0cb

	measure 'Revenue per Paying Customer' = DIVIDE([First Month Revenue],[Matched Paying Customers])
		formatString: "CAD "#,0.00
		displayFolder: Revenue
		lineageTag: ce321bc5-c1da-4271-97fd-3e0ce4f30dc0

	measure 'Revenue Records' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[revenue_eligible]=TRUE()))
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 6e6e6520-f13e-4a89-b7be-4bd87904edf6

	measure 'Missing Dates' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_date]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 868c9c01-652c-467b-b30a-e679e14a76e3

	measure 'Date Conflicts' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_date_month_conflict]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: c697ac45-92ff-4c24-a6e4-1aa1e7255558

	measure 'Incomplete Funnels' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_funnel]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 47511062-b6db-4cbb-b5e5-76c08b0da189

	measure 'Funnel Violations' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_funnel_order]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 11fefac1-828f-4286-a4ae-d4bde6559db6

	measure 'Missing Names' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_name]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 123135a7-5644-4deb-a107-3884bbad220d

	measure 'Missing Channels' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_channel]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: db994bad-2028-4546-aa45-7e003683832c

	measure 'Missing Segments' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_segment]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: eb643279-40ab-4b2f-a709-c5be0d8bdaab

	measure 'Negative Spend Records' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_negative_spend]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 4cbe1435-7a44-472b-b489-1185743d5356

	measure 'Missing Revenue' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_missing_revenue]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f6affd83-a516-423a-a001-6807b7a2c23e

	measure 'Identity Conflict Records' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[flag_campaign_id_conflict]=TRUE()))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 0c4d1950-f23e-4178-81b6-88599823ed8e

	measure 'Known Cost All Rows' = SUM(Fact_Campaigns[total_marketing_cost_cad])
		formatString: "CAD "#,0.00
		displayFolder: Data Quality
		lineageTag: 8ab99886-c782-4446-9115-bde484350f65

	measure 'Excluded Known Cost' = [Known Cost All Rows]-[Total Spend]
		formatString: "CAD "#,0.00
		displayFolder: Data Quality
		lineageTag: d001e095-3a1e-48d4-a7a8-da411153d881

	measure 'Reconstructed Costs' = CALCULATE(COUNTROWS(Fact_Campaigns),KEEPFILTERS(Fact_Campaigns[cost_basis]="complete component sum"))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 47374725-ebf2-46d3-ae39-6e7a2ba3e605

	measure 'Trusted Monthly Spend' = CALCULATE([Total Spend],KEEPFILTERS(Fact_Campaigns[date_eligible]=TRUE()))
		formatString: "CAD "#,0.00
		displayFolder: Time
		lineageTag: 0281dc1d-da2e-4c91-bd25-02a7b39dbdd8

	measure 'Trusted Monthly Revenue' = CALCULATE([First Month Revenue],KEEPFILTERS(Fact_Campaigns[date_eligible]=TRUE()))
		formatString: "CAD "#,0.00
		displayFolder: Time
		lineageTag: 16fd2b07-c692-40ea-bf90-7411ab6907e5

	measure 'Undated or Conflicted Spend' = [Total Spend]-[Trusted Monthly Spend]
		formatString: "CAD "#,0.00
		displayFolder: Time
		lineageTag: c9796444-9436-4e55-b468-f576b7f414ae

	measure 'Zero Output Family Spend' = SUMX(FILTER(VALUES(Fact_Campaigns[campaign_family]),[Eligible Records]>0 && NOT ISBLANK([Paying Customers]) && [Paying Customers]=0),[Total Spend])
		formatString: "CAD "#,0.00
		displayFolder: Budget Review
		lineageTag: c89f9d66-321b-42de-b560-e46774815ca8

	measure 'Zero Output Families' = COUNTROWS(FILTER(VALUES(Fact_Campaigns[campaign_family]),[Eligible Records]>0 && NOT ISBLANK([Paying Customers]) && [Paying Customers]=0))
		formatString: #,0
		displayFolder: Budget Review
		lineageTag: c4ff25e6-6546-48fa-a537-79abfae54d63

	measure 'Zero Output Spend Share' = DIVIDE([Zero Output Family Spend],[Total Spend])
		formatString: 0.0%
		displayFolder: Budget Review
		lineageTag: d23587ce-5b76-407a-b68b-27c5ef52d9ef

	measure 'Review Status' = SWITCH(TRUE(),[Eligible Records]=0,"No eligible records",ISBLANK([Paying Customers]),"Missing output",[Paying Customers]=0,"Investigate objective and lag","Evaluate with controlled test")
		displayFolder: Budget Review
		lineageTag: f197cdda-4734-4684-9130-907d484acf63

	measure 'Funnel Value' = SWITCH(SELECTEDVALUE(Funnel_Stages[Stage]),"Impressions",[Impressions],"Clicks",[Clicks],"Signups",[Signups],"KYC started",[KYC Started],"KYC completed",[KYC Completed],"Funded accounts",[Funded Accounts],"Paying customers",[Paying Customers])
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 7c6e7778-213a-4aad-8b26-2e37c8e6b50f

	measure 'Quality Issue Records' = SWITCH(SELECTEDVALUE(Quality_Issues[Issue]),"Missing dates",[Missing Dates],"Date conflicts",[Date Conflicts],"Incomplete funnels",[Incomplete Funnels],"Funnel violations",[Funnel Violations],"Missing names",[Missing Names],"Missing channels",[Missing Channels],"Missing segments",[Missing Segments],"Negative spend",[Negative Spend Records],"Missing revenue",[Missing Revenue])
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: db7befed-4644-4996-9cf7-6cbe5a7c6340

	measure 'Selected Channel Benchmark CAC' = CALCULATE([CAC],ALLSELECTED(Fact_Campaigns[marketing_channel]))
		formatString: "CAD "#,0.00
		displayFolder: Efficiency
		lineageTag: 76727f07-9488-441c-9b5c-cd755be434f6

	measure 'Above Benchmark Channel Count' = VAR Benchmark = [Selected Channel Benchmark CAC] VAR AboveBenchmark = FILTER(ALLSELECTED(Fact_Campaigns[marketing_channel]), NOT ISBLANK([CAC]) && [CAC] > Benchmark) RETURN IF(ISBLANK(Benchmark), BLANK(), COALESCE(COUNTROWS(AboveBenchmark), 0))
		formatString: #,0
		displayFolder: Efficiency
		lineageTag: 5ffea17f-5ec5-4b7d-bb71-81b850ad6b16

	measure 'Observed Efficiency Ratio' = DIVIDE([Selected Channel Benchmark CAC],[CAC])
		formatString: 0.00"x"
		displayFolder: Efficiency
		lineageTag: 941f75e4-6e17-4d8c-910b-9f74110d6a42

