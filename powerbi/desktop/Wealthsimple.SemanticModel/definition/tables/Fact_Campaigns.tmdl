table Fact_Campaigns
	lineageTag: 6d91ea82-edf3-4bc8-97fc-37b67b8caaa9

	measure 'Source Records' = COUNTROWS(Fact_Campaigns)
		formatString: #,0
		displayFolder: Overview
		lineageTag: c5e632bd-cafc-4516-b240-c8ccc6249304

	measure 'Eligible Records' = CALCULATE(COUNTROWS(Fact_Campaigns), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: #,0
		displayFolder: Overview
		lineageTag: fbf82a70-a09c-470e-ad2e-e21138074b2c

	measure 'Excluded Records' = [Source Records] - [Eligible Records]
		formatString: #,0
		displayFolder: Overview
		lineageTag: 60ff9f6d-ff66-409e-8812-0e81ca9c93ef

	measure 'Eligible Share' = DIVIDE([Eligible Records],[Source Records])
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: b2b68de6-96f1-4471-afb4-4812f3a98f14

	measure 'Total Spend' = CALCULATE(SUM(Fact_Campaigns[total_marketing_cost_cad]), KEEPFILTERS(Fact_Campaigns[analysis_eligible] = TRUE()))
		formatString: "CAD "#,0.00
		displayFolder: Overview
		lineageTag: 75247f64-bc34-43df-9c00-5d293246095d

