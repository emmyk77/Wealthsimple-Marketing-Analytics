{
  "name": "WealthsimpleMarketing",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-CA",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataRoot",
        "kind": "m",
        "expression": "\"C:/CHANGE_ME/Wealthsimple-Marketing-Analytics\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "Raw_Campaigns",
        "kind": "m",
        "expression": "let\n    Workbook = Excel.Workbook(File.Contents(DataRoot & \"/data/raw/Power_BI_project.xlsx\"), null, true),\n    Sheet = Workbook{[Item=\"Sheet1\",Kind=\"Sheet\"]}[Data],\n    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true])\nin Headers"
      }
    ],
    "tables": [
